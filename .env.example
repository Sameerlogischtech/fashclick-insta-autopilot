# System-user access token from Business settings -> Users -> System users -> Generate token
IG_ACCESS_TOKEN=paste-system-user-token-here
# Your Instagram account id (Business settings -> Accounts -> Instagram accounts, or run check_setup.py)
IG_USER_ID=paste-instagram-user-id-here
# Meta app -> App settings -> Basic -> App secret (click Show)
IG_APP_SECRET=paste-app-secret-here
# Any random word you choose; type the same one in the Meta webhook form
WEBHOOK_VERIFY_TOKEN=choose-any-secret-word
GRAPH_API_VERSION=v23.0
# Leave empty: picked automatically from the token (IG... = graph.instagram.com, EAA... = graph.facebook.com)
GRAPH_HOST=
# Leave empty. Only set to your Facebook Page id if sending DMs fails with "unsupported".
IG_MESSAGING_ID=
# true = only log what would happen, send nothing to Instagram
DRY_RUN=true
